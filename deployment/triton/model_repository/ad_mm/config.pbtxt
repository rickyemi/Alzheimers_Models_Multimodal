# Triton model configuration for the ONNX fusion model (copy models/ad_mm_fusion.onnx to ./1/model.onnx).
# For the TensorRT engine set platform: "tensorrt_plan" and place model.plan in ./1/.
name: "ad_mm"
platform: "onnxruntime_onnx"
max_batch_size: 32
input [
  { name: "image"          data_type: TYPE_FP32  dims: [ 1, 96, 96 ] },
  { name: "input_ids"      data_type: TYPE_INT64 dims: [ 96 ] },
  { name: "attention_mask" data_type: TYPE_INT64 dims: [ 96 ] },
  { name: "tabular"        data_type: TYPE_FP32  dims: [ 22 ] },
  { name: "modality_mask"  data_type: TYPE_FP32  dims: [ 3 ] }
]
output [
  { name: "probabilities"    data_type: TYPE_FP32 dims: [ 5 ] },
  { name: "modality_weights" data_type: TYPE_FP32 dims: [ 3 ] }
]
dynamic_batching { preferred_batch_size: [ 8, 16, 32 ] max_queue_delay_microseconds: 2000 }
instance_group [ { count: 2 kind: KIND_GPU } ]
optimization { execution_accelerators { gpu_execution_accelerator : [ { name : "tensorrt" parameters { key: "precision_mode" value: "FP16" } } ] } }
version_policy: { latest: { num_versions: 2 } }
